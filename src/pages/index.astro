---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSite } from '../lib/site';
import { withBase } from '../lib/paths';
import '../styles/global.css';

const site = getSite();

const projects = (await getCollection('projects'))
  .filter((project) => !project.data.draft)
  .sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title));

const linkedin =
  site.footer?.linkedinHref ??
  site.links.find((link) => /linkedin/i.test(link.label))?.href ??
  'https://www.linkedin.com/in/lucianareyes';
---

<BaseLayout title={site.seo.title} description={site.seo.description}>
  <div class="page">
    <header class="shell topbar">
      <a class="brand" href={withBase('/')}>{site.name}</a>
      <button
        type="button"
        class="theme-toggle"
        id="theme-toggle"
        aria-label="Toggle color theme"
      >
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M21 14.3A8.5 8.5 0 0 1 9.7 3 7 7 0 1 0 21 14.3Z"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linejoin="round"></path>
        </svg>
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.5"></circle>
          <path
            d="M12 2.5v2.2M12 19.3v2.2M4.7 4.7l1.6 1.6M17.7 17.7l1.6 1.6M2.5 12h2.2M19.3 12h2.2M4.7 19.3l1.6-1.6M17.7 6.3l1.6-1.6"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"></path>
        </svg>
      </button>
    </header>

    <main>
      <section class="shell intro" aria-label="Introduction">
        <p class="intro-copy">
          {site.intro.prefix}
          <s>{site.intro.struck}</s>{site.intro.suffix}
          {' '}
          <span class="specializing">{site.specializingLabel}</span>
        </p>
        <ul class="specialties">
          {site.specialties.map((item) => <li>{item}</li>)}
        </ul>
      </section>

      <hr class="shell divider" />

      <section class="shell philosophy" aria-labelledby="philosophy-heading">
        <div class="philosophy-grid">
          <h2 class="philosophy-label" id="philosophy-heading">{site.philosophy.label}</h2>
          <p class="philosophy-body">{site.philosophy.body}</p>
          <div class="accordion" data-accordion>
            {
              site.philosophy.items.map((item, index) => (
                <div class="accordion-item" data-open="false">
                  <button
                    type="button"
                    class="accordion-trigger"
                    aria-expanded="false"
                    id={`philosophy-trigger-${index}`}
                    aria-controls={`philosophy-panel-${index}`}
                  >
                    <span>{item.title}</span>
                    <span class="accordion-icon" aria-hidden="true" />
                  </button>
                  <div
                    class="accordion-panel"
                    id={`philosophy-panel-${index}`}
                    role="region"
                    aria-labelledby={`philosophy-trigger-${index}`}
                  >
                    <div class="accordion-panel-inner">
                      <p>{item.body}</p>
                    </div>
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      {
        projects.length > 0 && (
          <section class="shell work" aria-labelledby="work-heading">
            <h2 class="work-heading" id="work-heading">
              {site.workHeading}
            </h2>
            <ul class="work-grid">
              {projects.map((project) => {
                const href = project.data.externalUrl
                  ? project.data.externalUrl
                  : withBase(`projects/${project.id}/`);
                const external = Boolean(project.data.externalUrl);
                const summary = project.data.summary ?? project.data.subtitle ?? '';

                return (
                  <li>
                    <a
                      class="work-card"
                      href={href}
                      target={external ? '_blank' : undefined}
                      rel={external ? 'noopener noreferrer' : undefined}
                    >
                      {project.data.cover && (
                        <img
                          class="work-cover"
                          src={withBase(project.data.cover)}
                          alt=""
                          loading="lazy"
                        />
                      )}
                      <h3 class="work-title">{project.data.title}</h3>
                      {summary && <p class="work-summary">{summary}</p>}
                      {project.data.tags.length > 0 && (
                        <ul class="work-tags">
                          {project.data.tags.map((tag) => (
                            <li>{tag}</li>
                          ))}
                        </ul>
                      )}
                      <span class="work-cta">View case study →</span>
                    </a>
                  </li>
                );
              })}
            </ul>
          </section>
        )
      }

      {
        site.testimonials?.length > 0 && (
          <section class="testimonials" aria-label="Testimonials">
            <div class="shell testimonials-grid">
              {site.testimonials.map((item) => (
                <figure class="testimonial">
                  {item.avatar && (
                    <img
                      class="testimonial-avatar"
                      src={withBase(item.avatar)}
                      alt=""
                      width="54"
                      height="54"
                      loading="lazy"
                    />
                  )}
                  <blockquote class="testimonial-quote">
                    <p>{item.quote}</p>
                  </blockquote>
                  <figcaption class="testimonial-meta">
                    {item.name} - {item.role}
                  </figcaption>
                </figure>
              ))}
            </div>
          </section>
        )
      }
    </main>

    <footer class="site-footer">
      <div class="shell site-footer-inner">
        <span>{site.footer.location}</span>
        <a href={`mailto:${site.footer.email}`}>{site.footer.email}</a>
        <a href={linkedin} target="_blank" rel="noopener noreferrer">
          {site.footer.linkedinLabel}
        </a>
      </div>
    </footer>
  </div>

  <script>
    function getPreferredTheme() {
      const stored = localStorage.getItem('theme');
      if (stored === 'light' || stored === 'dark') return stored;
      return 'dark';
    }

    function applyTheme(theme) {
      document.documentElement.setAttribute('data-theme', theme);
      document.documentElement.style.colorScheme = theme;
      const meta = document.querySelector('meta[name="theme-color"]');
      if (meta) meta.setAttribute('content', theme === 'dark' ? '#0c0b0a' : '#f3efe8');
    }

    const toggle = document.getElementById('theme-toggle');
    applyTheme(getPreferredTheme());

    toggle?.addEventListener('click', () => {
      const next =
        document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
      localStorage.setItem('theme', next);
      applyTheme(next);
    });

    document.querySelectorAll('[data-accordion]').forEach((root) => {
      root.querySelectorAll('.accordion-item').forEach((item) => {
        const trigger = item.querySelector('.accordion-trigger');
        if (!(trigger instanceof HTMLButtonElement)) return;

        trigger.addEventListener('click', () => {
          const isOpen = item.getAttribute('data-open') === 'true';
          root.querySelectorAll('.accordion-item').forEach((other) => {
            other.setAttribute('data-open', 'false');
            other
              .querySelector('.accordion-trigger')
              ?.setAttribute('aria-expanded', 'false');
          });
          if (!isOpen) {
            item.setAttribute('data-open', 'true');
            trigger.setAttribute('aria-expanded', 'true');
          }
        });
      });
    });
  </script>
</BaseLayout>
