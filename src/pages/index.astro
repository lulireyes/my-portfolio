---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Topbar from '../components/Topbar.astro';
import { getSite } from '../lib/site';
import { withBase } from '../lib/paths';
import '../styles/global.css';

const site = getSite();

const projects = (await getCollection('projects'))
  .filter((project) => !project.data.draft)
  .sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title));

const flipHint = 'Click to flip';
const flipBackHint = 'Click to flip back';
---

<BaseLayout title={site.seo.title} description={site.seo.description}>
  <div class="page">
    <Topbar />

    <main>
      <section class="shell intro" aria-labelledby="intro-heading">
        <h1 class="intro-headline" id="intro-heading">
          {site.intro.prefix}
          <s class="intro-struck">{site.intro.struck}</s>{site.intro.afterStruck}<span
            class="intro-accent">{site.intro.accentPhrase}</span
          >{site.intro.tail}
        </h1>
        <p class="intro-specializing">{site.specializingLabel}</p>
        <ul class="specialties" aria-label="Specialties">
          {
            site.specialties.map((item) => (
              <li>
                <span class="specialty-chip">{item}</span>
              </li>
            ))
          }
        </ul>
      </section>

      <hr class="divider" />

      <section class="shell philosophy" aria-labelledby="philosophy-heading">
        <div class="philosophy-layout">
          <h2 class="philosophy-label" id="philosophy-heading">{site.philosophy.label}</h2>
          <div class="philosophy-main">
            <div class="philosophy-copy">
              {site.philosophy.paragraphs.map((paragraph) => <p class="philosophy-body">{paragraph}</p>)}
              {
                site.philosophy.learnMore && (
                  <a class="philosophy-more" href={`${withBase('/')}${site.philosophy.learnMore.href}`}>
                    {site.philosophy.learnMore.label}
                  </a>
                )
              }
            </div>
            <div class="flip-cards" data-flip-cards>
              <p class="flip-cards-hint" id="flip-cards-hint">
                Select a card to flip it and read more
              </p>
              {
                site.philosophy.items.map((item, index) => {
                  const number = String(index + 1).padStart(2, '0');
                  return (
                    <button
                      type="button"
                      class="flip-card"
                      aria-pressed="false"
                      aria-describedby="flip-cards-hint"
                      data-title={item.title}
                      aria-label={`${item.title}. ${flipHint}.`}
                      id={`philosophy-card-${index}`}
                    >
                      <span class="flip-card-inner">
                        <span class="flip-card-face flip-card-front">
                          <span class="flip-card-title">{item.title}</span>
                          <span class="flip-card-affordance" aria-hidden="true">
                            <svg class="flip-card-rotate" viewBox="0 0 24 24" fill="none">
                              <path
                                d="M4.5 8.25A7.5 7.5 0 0 1 19.2 9M19.5 15.75A7.5 7.5 0 0 1 4.8 15"
                                stroke="currentColor"
                                stroke-width="1.5"
                                stroke-linecap="round"
                              />
                              <path
                                d="M19.2 9V5.5M19.2 9H15.7M4.8 15v3.5M4.8 15h3.5"
                                stroke="currentColor"
                                stroke-width="1.5"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                              />
                            </svg>
                            <span class="flip-card-hint">{flipHint}</span>
                          </span>
                          <span class="flip-card-number" aria-hidden="true">
                            {number}
                          </span>
                        </span>
                        <span class="flip-card-face flip-card-back">
                          <span class="flip-card-body">{item.body}</span>
                          <span class="flip-card-affordance flip-card-affordance--back" aria-hidden="true">
                            <span class="flip-card-hint">{flipBackHint}</span>
                          </span>
                        </span>
                      </span>
                    </button>
                  );
                })
              }
            </div>
          </div>
        </div>
      </section>

      {
        projects.length > 0 && (
          <section class="shell work" id="work" aria-labelledby="work-heading">
            <h2 class="work-heading" id="work-heading">
              {site.workHeading}
            </h2>
            <ul class="work-grid">
              {projects.map((project) => {
                const href = project.data.externalUrl
                  ? project.data.externalUrl
                  : withBase(`projects/${project.id}/`);
                const external = Boolean(project.data.externalUrl);
                const summary = project.data.summary ?? project.data.subtitle ?? '';

                return (
                  <li>
                    <a
                      class="work-card"
                      href={href}
                      target={external ? '_blank' : undefined}
                      rel={external ? 'noopener noreferrer' : undefined}
                    >
                      {project.data.cover && (
                        <img
                          class="work-cover"
                          src={withBase(project.data.cover)}
                          alt=""
                          loading="lazy"
                        />
                      )}
                      <h3 class="work-title">{project.data.title}</h3>
                      {summary && <p class="work-summary">{summary}</p>}
                      {project.data.tags.length > 0 && (
                        <ul class="work-tags">
                          {project.data.tags.map((tag) => (
                            <li>{tag}</li>
                          ))}
                        </ul>
                      )}
                      <span class="work-cta">View case study →</span>
                    </a>
                  </li>
                );
              })}
            </ul>
          </section>
        )
      }

      {
        site.testimonials?.length > 0 && (
          <section class="testimonials" aria-label="Testimonials">
            <div class="shell testimonials-grid">
              {site.testimonials.map((item) => (
                <figure class="testimonial">
                  {item.avatar && (
                    <img
                      class="testimonial-avatar"
                      src={withBase(item.avatar)}
                      alt=""
                      width="64"
                      height="64"
                      loading="lazy"
                    />
                  )}
                  <blockquote class="testimonial-quote">
                    <p>{item.quote}</p>
                  </blockquote>
                  <figcaption class="testimonial-meta">
                    {item.name} - {item.role}
                  </figcaption>
                </figure>
              ))}
            </div>
          </section>
        )
      }

      {
        site.about && (
          <section class="shell about" id="about" aria-labelledby="about-heading">
            <h2 class="about-heading" id="about-heading">
              {site.about.heading}
            </h2>
            <p class="about-path">{site.about.path}</p>
            <div class="about-blocks">
              {site.about.blocks.map((block) => (
                <div class="about-block">
                  {block.photo && (
                    <img
                      class="about-photo"
                      src={withBase(block.photo)}
                      alt=""
                      width="160"
                      height="160"
                      loading="lazy"
                    />
                  )}
                  <p class="about-text">{block.text}</p>
                </div>
              ))}
            </div>
          </section>
        )
      }

      {
        site.journey && (
          <section class="shell journey" aria-labelledby="journey-heading">
            <h2 class="journey-heading" id="journey-heading">
              {site.journey.heading}
            </h2>
            <ul class="journey-list">
              {site.journey.items.map((item) => (
                <li class="journey-item">
                  <div class="journey-rail" aria-hidden="true">
                    <span class="journey-logo-frame">
                      {item.logo && (
                        <img
                          class="journey-logo"
                          src={withBase(item.logo)}
                          alt=""
                          width="56"
                          height="56"
                          loading="lazy"
                        />
                      )}
                    </span>
                  </div>
                  <div class="journey-body">
                    <p class="journey-dates">{item.dates}</p>
                    <h3 class="journey-company">{item.company}</h3>
                    <p class="journey-role">{item.role}</p>
                    {item.description && <p class="journey-desc">{item.description}</p>}
                    {(item.tags?.length || item.caseStudy) && (
                      <div class="journey-meta">
                        {item.tags?.length ? (
                          <ul class="journey-tags" aria-label={`${item.company} focus areas`}>
                            {item.tags.map((tag) => (
                              <li>{tag}</li>
                            ))}
                          </ul>
                        ) : null}
                        {item.caseStudy && (
                          <a
                            class="journey-case"
                            href={withBase(`projects/${item.caseStudy}/`)}
                          >
                            Case study
                            <svg
                              class="journey-case-icon"
                              viewBox="0 0 24 24"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="2"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              aria-hidden="true"
                            >
                              <path d="M9 5l7 7-7 7" />
                            </svg>
                          </a>
                        )}
                      </div>
                    )}
                  </div>
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </main>

    <footer class="site-footer" id="contact">
      <div class="shell site-footer-inner">
        <p class="footer-thanks">{site.footer.thanks}</p>
        {site.footer.smile && <p class="footer-smile">{site.footer.smile}</p>}
        <a class="footer-email" href={`mailto:${site.footer.email}`}>
          {site.footer.email}
        </a>
        <p class="footer-location">{site.footer.location}</p>
      </div>
    </footer>
  </div>

  <script>
    function getPreferredTheme() {
      const stored = localStorage.getItem('theme');
      if (stored === 'light' || stored === 'dark') return stored;
      return 'dark';
    }

    function applyTheme(theme) {
      document.documentElement.setAttribute('data-theme', theme);
      document.documentElement.style.colorScheme = theme;
      const meta = document.querySelector('meta[name="theme-color"]');
      if (meta) meta.setAttribute('content', theme === 'dark' ? '#0d0d0d' : '#f3efe8');
      const toggleBtn = document.getElementById('theme-toggle');
      if (toggleBtn) {
        toggleBtn.setAttribute(
          'aria-label',
          theme === 'dark' ? 'Switch to light mode' : 'Switch to dark mode'
        );
      }
    }

    const toggle = document.getElementById('theme-toggle');
    applyTheme(getPreferredTheme());

    toggle?.addEventListener('click', () => {
      const next =
        document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
      localStorage.setItem('theme', next);
      applyTheme(next);
    });

    document.querySelectorAll('[data-flip-cards]').forEach((root) => {
      root.querySelectorAll('.flip-card').forEach((card) => {
        if (!(card instanceof HTMLButtonElement)) return;

        const title = card.dataset.title ?? 'Card';

        card.addEventListener('click', () => {
          const pressed = card.getAttribute('aria-pressed') === 'true';
          const next = !pressed;
          card.setAttribute('aria-pressed', next ? 'true' : 'false');
          card.setAttribute(
            'aria-label',
            next ? `${title}. Showing details. Click to flip back.` : `${title}. Click to flip.`
          );
        });
      });
    });
  </script>
</BaseLayout>
