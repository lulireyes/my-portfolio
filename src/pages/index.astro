---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSite } from '../lib/site';
import { withBase } from '../lib/paths';
import '../styles/global.css';

const site = getSite();

const projects = (await getCollection('projects'))
  .filter((project) => !project.data.draft)
  .sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title));

const linkedin =
  site.footer?.linkedinHref ??
  site.links.find((link) => /linkedin/i.test(link.label))?.href ??
  'https://www.linkedin.com/in/lucianareyes';

const home = withBase('/');
const nav = site.nav ?? [
  { label: 'Work', href: '#work' },
  { label: 'About', href: '#about' },
  { label: 'Contact', href: '#contact' },
];

const philosophyIcons: Record<string, { viewBox: string; paths: string }> = {
  everyone: {
    viewBox: '0 0 24 24',
    paths:
      'M12 12a3.25 3.25 0 1 0 0-6.5 3.25 3.25 0 0 0 0 6.5ZM5.5 19.25c.9-2.85 3.2-4.5 6.5-4.5s5.6 1.65 6.5 4.5M16.75 8.5a2.5 2.5 0 1 0-1.1-4.75M18.9 14.2c1.55.55 2.6 1.7 3.1 3.3',
  },
  strategy: {
    viewBox: '0 0 24 24',
    paths:
      'M12 3.5v3M12 17.5v3M3.5 12h3M17.5 12h3M6.4 6.4l2.1 2.1M15.5 15.5l2.1 2.1M17.6 6.4l-2.1 2.1M8.5 15.5l-2.1 2.1M12 15.25a3.25 3.25 0 1 0 0-6.5 3.25 3.25 0 0 0 0 6.5Z',
  },
  collaboration: {
    viewBox: '0 0 24 24',
    paths:
      'M8.25 10.25a2.75 2.75 0 1 0 0-5.5 2.75 2.75 0 0 0 0 5.5ZM15.75 10.25a2.75 2.75 0 1 0 0-5.5 2.75 2.75 0 0 0 0 5.5ZM3.75 19c.7-2.4 2.55-3.75 4.5-3.75s3.8 1.35 4.5 3.75M11.25 19c.7-2.4 2.55-3.75 4.5-3.75s3.8 1.35 4.5 3.75',
  },
  evidence: {
    viewBox: '0 0 24 24',
    paths:
      'M10.5 17.25a6.75 6.75 0 1 0 0-13.5 6.75 6.75 0 0 0 0 13.5ZM15.5 15.5 20 20',
  },
  launch: {
    viewBox: '0 0 24 24',
    paths:
      'M4.5 12a7.5 7.5 0 0 1 12.4-5.7M19.5 12a7.5 7.5 0 0 1-12.4 5.7M16 3.8l.9 3.4 3.4.9-3.4.9-.9 3.4-.9-3.4-3.4-.9 3.4-.9.9-3.4ZM8 12.5l.55 2.05 2.05.55-2.05.55L8 17.7l-.55-2.05-2.05-.55 2.05-.55L8 12.5Z',
  },
};
---

<BaseLayout title={site.seo.title} description={site.seo.description}>
  <div class="page">
    <header class="shell topbar">
      <a class="brand" href={home}>{site.name}</a>
      <nav class="site-nav" aria-label="Primary">
        <ul class="site-nav-list">
          {
            nav.map((item) => {
              const hash = item.href.startsWith('#') ? item.href : `#${item.href}`;
              return (
                <li>
                  <a href={`${home}${hash}`}>{item.label}</a>
                </li>
              );
            })
          }
        </ul>
      </nav>
      <button
        type="button"
        class="theme-toggle"
        id="theme-toggle"
        aria-label="Toggle color theme"
      >
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M21 14.3A8.5 8.5 0 0 1 9.7 3 7 7 0 1 0 21 14.3Z"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linejoin="round"></path>
        </svg>
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.5"></circle>
          <path
            d="M12 2.5v2.2M12 19.3v2.2M4.7 4.7l1.6 1.6M17.7 17.7l1.6 1.6M2.5 12h2.2M19.3 12h2.2M4.7 19.3l1.6-1.6M17.7 6.3l1.6-1.6"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"></path>
        </svg>
      </button>
    </header>

    <main>
      <section class="shell intro" aria-label="Introduction">
        <p class="intro-copy">
          {site.intro.prefix}
          <s>{site.intro.struck}</s>{site.intro.suffix}
          {' '}
          <span class="specializing">{site.specializingLabel}</span>
        </p>
        <ul class="specialties">
          {site.specialties.map((item) => <li>{item}</li>)}
        </ul>
      </section>

      <hr class="divider" />

      <section class="shell philosophy" id="about" aria-labelledby="philosophy-heading">
        <div class="philosophy-intro">
          <h2 class="philosophy-label" id="philosophy-heading">{site.philosophy.label}</h2>
          <p class="philosophy-body">{site.philosophy.body}</p>
        </div>
        <div class="flip-cards" data-flip-cards>
          {
            site.philosophy.items.map((item, index) => {
              const icon = philosophyIcons[item.icon ?? ''] ?? philosophyIcons.everyone;
              return (
                <button
                  type="button"
                  class="flip-card"
                  aria-pressed="false"
                  aria-label={`${item.title}. Flip card for details.`}
                  id={`philosophy-card-${index}`}
                >
                  <span class="flip-card-inner">
                    <span class="flip-card-face flip-card-front">
                      <span class="flip-card-title">{item.title}</span>
                      <svg
                        class="flip-card-icon"
                        viewBox={icon.viewBox}
                        fill="none"
                        aria-hidden="true"
                      >
                        <path
                          d={icon.paths}
                          stroke="currentColor"
                          stroke-width="1.5"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                    </span>
                    <span class="flip-card-face flip-card-back">
                      <span class="flip-card-back-title">{item.title}</span>
                      <span class="flip-card-body">{item.body}</span>
                    </span>
                  </span>
                </button>
              );
            })
          }
        </div>
      </section>

      {
        projects.length > 0 && (
          <section class="shell work" id="work" aria-labelledby="work-heading">
            <h2 class="work-heading" id="work-heading">
              {site.workHeading}
            </h2>
            <ul class="work-grid">
              {projects.map((project) => {
                const href = project.data.externalUrl
                  ? project.data.externalUrl
                  : withBase(`projects/${project.id}/`);
                const external = Boolean(project.data.externalUrl);
                const summary = project.data.summary ?? project.data.subtitle ?? '';

                return (
                  <li>
                    <a
                      class="work-card"
                      href={href}
                      target={external ? '_blank' : undefined}
                      rel={external ? 'noopener noreferrer' : undefined}
                    >
                      {project.data.cover && (
                        <img
                          class="work-cover"
                          src={withBase(project.data.cover)}
                          alt=""
                          loading="lazy"
                        />
                      )}
                      <h3 class="work-title">{project.data.title}</h3>
                      {summary && <p class="work-summary">{summary}</p>}
                      {project.data.tags.length > 0 && (
                        <ul class="work-tags">
                          {project.data.tags.map((tag) => (
                            <li>{tag}</li>
                          ))}
                        </ul>
                      )}
                      <span class="work-cta">View case study →</span>
                    </a>
                  </li>
                );
              })}
            </ul>
          </section>
        )
      }

      {
        site.testimonials?.length > 0 && (
          <section class="testimonials" aria-label="Testimonials">
            <div class="shell testimonials-grid">
              {site.testimonials.map((item) => (
                <figure class="testimonial">
                  {item.avatar && (
                    <img
                      class="testimonial-avatar"
                      src={withBase(item.avatar)}
                      alt=""
                      width="64"
                      height="64"
                      loading="lazy"
                    />
                  )}
                  <blockquote class="testimonial-quote">
                    <p>{item.quote}</p>
                  </blockquote>
                  <figcaption class="testimonial-meta">
                    {item.name} - {item.role}
                  </figcaption>
                </figure>
              ))}
            </div>
          </section>
        )
      }
    </main>

    <footer class="site-footer" id="contact">
      <div class="shell site-footer-inner">
        <span>{site.footer.location}</span>
        <a href={`mailto:${site.footer.email}`}>{site.footer.email}</a>
        <a href={linkedin} target="_blank" rel="noopener noreferrer">
          {site.footer.linkedinLabel}
        </a>
      </div>
    </footer>
  </div>

  <script>
    function getPreferredTheme() {
      const stored = localStorage.getItem('theme');
      if (stored === 'light' || stored === 'dark') return stored;
      return 'dark';
    }

    function applyTheme(theme) {
      document.documentElement.setAttribute('data-theme', theme);
      document.documentElement.style.colorScheme = theme;
      const meta = document.querySelector('meta[name="theme-color"]');
      if (meta) meta.setAttribute('content', theme === 'dark' ? '#0d0d0d' : '#f3efe8');
    }

    const toggle = document.getElementById('theme-toggle');
    applyTheme(getPreferredTheme());

    toggle?.addEventListener('click', () => {
      const next =
        document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
      localStorage.setItem('theme', next);
      applyTheme(next);
    });

    document.querySelectorAll('[data-flip-cards]').forEach((root) => {
      root.querySelectorAll('.flip-card').forEach((card) => {
        if (!(card instanceof HTMLButtonElement)) return;

        card.addEventListener('click', () => {
          const pressed = card.getAttribute('aria-pressed') === 'true';
          card.setAttribute('aria-pressed', pressed ? 'false' : 'true');
        });
      });
    });
  </script>
</BaseLayout>
