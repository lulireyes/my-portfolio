---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Topbar from '../components/Topbar.astro';
import { getSite } from '../lib/site';
import { withBase } from '../lib/paths';
import '../styles/global.css';

const site = getSite();

const projects = (await getCollection('projects'))
  .filter((project) => !project.data.draft)
  .sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title));

const philosophyIcons: Record<string, { viewBox: string; paths: string }> = {
  everyone: {
    viewBox: '0 0 24 24',
    paths:
      'M12 12a3.25 3.25 0 1 0 0-6.5 3.25 3.25 0 0 0 0 6.5ZM5.5 19.25c.9-2.85 3.2-4.5 6.5-4.5s5.6 1.65 6.5 4.5M16.75 8.5a2.5 2.5 0 1 0-1.1-4.75M18.9 14.2c1.55.55 2.6 1.7 3.1 3.3',
  },
  strategy: {
    viewBox: '0 0 24 24',
    paths:
      'M12 3.5v3M12 17.5v3M3.5 12h3M17.5 12h3M6.4 6.4l2.1 2.1M15.5 15.5l2.1 2.1M17.6 6.4l-2.1 2.1M8.5 15.5l-2.1 2.1M12 15.25a3.25 3.25 0 1 0 0-6.5 3.25 3.25 0 0 0 0 6.5Z',
  },
  collaboration: {
    viewBox: '0 0 24 24',
    paths:
      'M8.25 10.25a2.75 2.75 0 1 0 0-5.5 2.75 2.75 0 0 0 0 5.5ZM15.75 10.25a2.75 2.75 0 1 0 0-5.5 2.75 2.75 0 0 0 0 5.5ZM3.75 19c.7-2.4 2.55-3.75 4.5-3.75s3.8 1.35 4.5 3.75M11.25 19c.7-2.4 2.55-3.75 4.5-3.75s3.8 1.35 4.5 3.75',
  },
  evidence: {
    viewBox: '0 0 24 24',
    paths:
      'M10.5 17.25a6.75 6.75 0 1 0 0-13.5 6.75 6.75 0 0 0 0 13.5ZM15.5 15.5 20 20',
  },
};
---

<BaseLayout title={site.seo.title} description={site.seo.description}>
  <div class="page">
    <Topbar />

    <main>
      <section class="shell intro" aria-label="Introduction">
        <p class="intro-copy">
          {site.intro.prefix}
          <s>{site.intro.struck}</s>{site.intro.suffix}
          <br />
          {site.specializingLabel}
        </p>
        <ul class="specialties">
          {site.specialties.map((item) => <li>{item}</li>)}
        </ul>
      </section>

      <hr class="divider" />

      <section class="shell philosophy" aria-labelledby="philosophy-heading">
        <div class="philosophy-layout">
          <h2 class="philosophy-label" id="philosophy-heading">{site.philosophy.label}</h2>
          <div class="philosophy-main">
            <p class="philosophy-body">{site.philosophy.body}</p>
            <div class="flip-cards" data-flip-cards>
              {
                site.philosophy.items.map((item, index) => {
                  const icon = philosophyIcons[item.icon ?? ''] ?? philosophyIcons.everyone;
                  return (
                    <button
                      type="button"
                      class="flip-card"
                      aria-pressed="false"
                      aria-label={`${item.title}. Flip card for details.`}
                      id={`philosophy-card-${index}`}
                    >
                      <span class="flip-card-inner">
                        <span class="flip-card-face flip-card-front">
                          <span class="flip-card-title">{item.title}</span>
                          <svg
                            class="flip-card-icon"
                            viewBox={icon.viewBox}
                            fill="none"
                            aria-hidden="true"
                          >
                            <path
                              d={icon.paths}
                              stroke="currentColor"
                              stroke-width="1.5"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                            />
                          </svg>
                        </span>
                        <span class="flip-card-face flip-card-back">
                          <span class="flip-card-body">{item.body}</span>
                        </span>
                      </span>
                    </button>
                  );
                })
              }
            </div>
          </div>
        </div>
      </section>

      {
        projects.length > 0 && (
          <section class="shell work" id="work" aria-labelledby="work-heading">
            <h2 class="work-heading" id="work-heading">
              {site.workHeading}
            </h2>
            <ul class="work-grid">
              {projects.map((project) => {
                const href = project.data.externalUrl
                  ? project.data.externalUrl
                  : withBase(`projects/${project.id}/`);
                const external = Boolean(project.data.externalUrl);
                const summary = project.data.summary ?? project.data.subtitle ?? '';

                return (
                  <li>
                    <a
                      class="work-card"
                      href={href}
                      target={external ? '_blank' : undefined}
                      rel={external ? 'noopener noreferrer' : undefined}
                    >
                      {project.data.cover && (
                        <img
                          class="work-cover"
                          src={withBase(project.data.cover)}
                          alt=""
                          loading="lazy"
                        />
                      )}
                      <h3 class="work-title">{project.data.title}</h3>
                      {summary && <p class="work-summary">{summary}</p>}
                      {project.data.tags.length > 0 && (
                        <ul class="work-tags">
                          {project.data.tags.map((tag) => (
                            <li>{tag}</li>
                          ))}
                        </ul>
                      )}
                      <span class="work-cta">View case study →</span>
                    </a>
                  </li>
                );
              })}
            </ul>
          </section>
        )
      }

      {
        site.testimonials?.length > 0 && (
          <section class="testimonials" aria-label="Testimonials">
            <div class="shell testimonials-grid">
              {site.testimonials.map((item) => (
                <figure class="testimonial">
                  {item.avatar && (
                    <img
                      class="testimonial-avatar"
                      src={withBase(item.avatar)}
                      alt=""
                      width="64"
                      height="64"
                      loading="lazy"
                    />
                  )}
                  <blockquote class="testimonial-quote">
                    <p>{item.quote}</p>
                  </blockquote>
                  <figcaption class="testimonial-meta">
                    {item.name} - {item.role}
                  </figcaption>
                </figure>
              ))}
            </div>
          </section>
        )
      }

      {
        site.about && (
          <section class="shell about" id="about" aria-labelledby="about-heading">
            <h2 class="about-heading" id="about-heading">
              {site.about.heading}
            </h2>
            <p class="about-path">{site.about.path}</p>
            <div class="about-blocks">
              {site.about.blocks.map((block) => (
                <div class="about-block">
                  {block.photo && (
                    <img
                      class="about-photo"
                      src={withBase(block.photo)}
                      alt=""
                      width="160"
                      height="160"
                      loading="lazy"
                    />
                  )}
                  <p class="about-text">{block.text}</p>
                </div>
              ))}
            </div>
          </section>
        )
      }

      {
        site.journey && (
          <section class="shell journey" aria-labelledby="journey-heading">
            <h2 class="journey-heading" id="journey-heading">
              {site.journey.heading}
            </h2>
            <ul class="journey-list">
              {site.journey.items.map((item) => (
                <li class="journey-item">
                  {item.logo && (
                    <img
                      class="journey-logo"
                      src={withBase(item.logo)}
                      alt=""
                      width="48"
                      height="48"
                      loading="lazy"
                    />
                  )}
                  <div class="journey-copy">
                    <span class="journey-company">{item.company}</span>
                    <span class="journey-role">{item.role}</span>
                  </div>
                  <span class="journey-dates">{item.dates}</span>
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </main>

    <footer class="site-footer" id="contact">
      <div class="shell site-footer-inner">
        <p class="footer-thanks">{site.footer.thanks}</p>
        {site.footer.smile && <p class="footer-smile">{site.footer.smile}</p>}
        <a class="footer-email" href={`mailto:${site.footer.email}`}>
          {site.footer.email}
        </a>
        <p class="footer-location">{site.footer.location}</p>
      </div>
    </footer>
  </div>

  <script>
    function getPreferredTheme() {
      const stored = localStorage.getItem('theme');
      if (stored === 'light' || stored === 'dark') return stored;
      return 'dark';
    }

    function applyTheme(theme) {
      document.documentElement.setAttribute('data-theme', theme);
      document.documentElement.style.colorScheme = theme;
      const meta = document.querySelector('meta[name="theme-color"]');
      if (meta) meta.setAttribute('content', theme === 'dark' ? '#0d0d0d' : '#f3efe8');
    }

    const toggle = document.getElementById('theme-toggle');
    applyTheme(getPreferredTheme());

    toggle?.addEventListener('click', () => {
      const next =
        document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
      localStorage.setItem('theme', next);
      applyTheme(next);
    });

    document.querySelectorAll('[data-flip-cards]').forEach((root) => {
      root.querySelectorAll('.flip-card').forEach((card) => {
        if (!(card instanceof HTMLButtonElement)) return;

        card.addEventListener('click', () => {
          const pressed = card.getAttribute('aria-pressed') === 'true';
          card.setAttribute('aria-pressed', pressed ? 'false' : 'true');
        });
      });
    });
  </script>
</BaseLayout>
