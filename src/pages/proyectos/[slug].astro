---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { dictionary } from '../../i18n';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  const entries = await getCollection('proyectos');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const t = dictionary('es');
const projectCount = (await getCollection('proyectos')).length;
const developing = entry.data.status === t.project.inDevelopment;
---

<BaseLayout
  locale="es"
  projectCount={projectCount}
  title={entry.data.title}
  description={entry.data.summary}
>
  <main id="content" class="project">
    <p class="project__kicker">
      <a href="/#indice">{t.project.back}</a>
      <span> / {entry.data.number}</span>
    </p>
    <h1>{entry.data.title}</h1>
    <p class="project__meta">
      <span>{entry.data.disciplines.join(', ')}</span>
      <span>{entry.data.year}</span>
      <span class:list={[{ 'project__status': developing }]}>
        {developing && <span class="project__dot" aria-hidden="true" />}
        {entry.data.status}
      </span>
    </p>
    <figure class="project__cover">
      <Image src={entry.data.cover} alt={entry.data.coverAlt} />
      <figcaption>{entry.data.number} — {t.index.captionPlaceholder}</figcaption>
    </figure>
    <p class="project__summary">{entry.data.summary}</p>
    <div class="project__body">
      <Content />
    </div>
  </main>
  <Footer locale="es" />
</BaseLayout>

<style>
  .project {
    padding: 80px 0 40px;
  }

  .project__kicker {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--muted);
    margin-bottom: 16px;
  }

  .project__kicker a {
    text-decoration: none;
  }

  .project h1 {
    font-size: clamp(40px, 6vw, 72px);
    font-weight: 500;
    letter-spacing: -0.03em;
    font-stretch: 85%;
    font-variation-settings: 'wdth' 85;
    line-height: 1.02;
  }

  .project__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    margin-top: 20px;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--muted);
  }

  .project__status {
    color: var(--ink);
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .project__dot {
    width: 8px;
    height: 8px;
    background: var(--cobalt);
    display: inline-block;
  }

  .project__cover {
    margin: 40px 0 0;
  }

  .project__cover img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    background: var(--placeholder-bg);
  }

  .project__cover figcaption {
    margin-top: 10px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
  }

  .project__summary {
    margin-top: 40px;
    max-width: 42rem;
    font-size: 18px;
    line-height: 1.5;
    color: var(--ink-soft);
  }

  .project__body {
    margin-top: 24px;
    max-width: 42rem;
    font-size: 16px;
    line-height: 1.6;
    color: var(--ink-soft);
  }
</style>
