---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Topbar from '../../components/Topbar.astro';
import { getSite } from '../../lib/site';
import { withBase } from '../../lib/paths';
import '../../styles/global.css';

export async function getStaticPaths() {
  const projects = await getCollection(
    'projects',
    ({ data }) => !data.draft && !data.externalUrl,
  );

  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project, projects },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
  projects: CollectionEntry<'projects'>[];
}

const { project, projects } = Astro.props;
const site = getSite();
const linkedIn = site.links?.find((l) => /linkedin/i.test(l.label) || /linkedin/i.test(l.href));

const ordered = [...projects].sort(
  (a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title),
);

const currentIndex = ordered.findIndex((p) => p.id === project.id);
const prevProject =
  ordered.length > 1
    ? ordered[(currentIndex - 1 + ordered.length) % ordered.length]
    : undefined;
const nextProject =
  ordered.length > 1 ? ordered[(currentIndex + 1) % ordered.length] : undefined;

const { Content } = await render(project);
const d = project.data;
const overviewRaw = d.overview ?? d.summary ?? d.subtitle ?? '';
const summaryParagraphs = Array.isArray(overviewRaw)
  ? overviewRaw
  : overviewRaw
    ? [overviewRaw]
    : [];
const period = d.period ?? (d.year ? String(d.year) : '');
const hasSections = d.sections.length > 0;
const marqueeRepeats = Math.max(24, Math.ceil(480 / Math.max(d.title.length, 1)));

function sectionMarqueeRepeats(title: string) {
  return Math.max(18, Math.ceil(480 / Math.max(title.length, 1)));
}
---

<BaseLayout
  title={`${project.data.title} — ${site.name}`}
  description={project.data.summary ?? project.data.subtitle ?? site.seo.description}
>
  <div class="case-page">
    <Topbar />

    <main>
      <article class="case-study" id={project.id} data-project={project.id}>
        <header class="case-hero shell-case">
          <h1 class="case-title">{d.title}</h1>
          {d.subtitle && <p class="case-subtitle">{d.subtitle}</p>}
        </header>

        <section class="case-summary-block shell-case" aria-labelledby={`summary-${project.id}`}>
          <div class="case-summary-main">
            <h2 class="case-section-title" id={`summary-${project.id}`}>
              Summary
            </h2>
            {
              summaryParagraphs.map((paragraph) => (
                <p class="case-body">{paragraph}</p>
              ))
            }
          </div>
          <aside class="case-meta" aria-label="Project details">
            {
              d.role && (
                <div class="case-meta-item">
                  <span class="case-meta-label">Role</span>
                  <p class="case-meta-value">{d.role}</p>
                </div>
              )
            }
            {
              period && (
                <div class="case-meta-item">
                  <span class="case-meta-label">Year</span>
                  <p class="case-meta-value">{period}</p>
                </div>
              )
            }
            {
              d.market && (
                <div class="case-meta-item">
                  <span class="case-meta-label">Product / Market</span>
                  <p class="case-meta-value">{d.market}</p>
                </div>
              )
            }
          </aside>
        </section>

        {
          d.highlights.length > 0 && (
            <section
              class="case-highlights shell-case"
              aria-labelledby={`highlights-${project.id}`}
            >
              <h2 class="case-section-display" id={`highlights-${project.id}`}>
                Highlights
              </h2>
              <div class="case-highlights-body">
                {d.highlights.map((line) =>
                  typeof line === 'string' ? (
                    <p class="case-body">{line}</p>
                  ) : (
                    <p class="case-body">
                      {line.before}
                      <a class="case-highlight-link" href={line.href}>
                        {line.title}
                      </a>
                      {line.after}
                      {line.emphasis && <strong>{line.emphasis}</strong>}
                      {line.afterEmphasis}
                    </p>
                  ),
                )}
              </div>
            </section>
          )
        }

        {
          hasSections ? (
            d.sections.map((section) => (
              <section class="case-part" id={section.id} aria-labelledby={`${section.id}-title`}>
                <div class="case-marquee" aria-hidden="true" data-marquee-label={section.title}>
                  <div class="case-marquee-track">
                    {[0, 1].map(() => (
                      <div class="case-marquee-group">
                        {Array.from({ length: sectionMarqueeRepeats(section.title) }).map(() => (
                          <span class="case-marquee-item">
                            <span>{section.title}</span>
                            {section.emoji ? (
                              <span class="case-marquee-emoji">{section.emoji}</span>
                            ) : (
                              <span class="case-marquee-sep" />
                            )}
                          </span>
                        ))}
                      </div>
                    ))}
                  </div>
                </div>

                <div class="case-part-inner shell-case">
                  <h2 class="case-part-title" id={`${section.id}-title`}>
                    {section.title}
                  </h2>

                  <div class="case-summary-block" aria-labelledby={`${section.id}-summary`}>
                    <div class="case-summary-main">
                      <h3 class="case-section-title" id={`${section.id}-summary`}>
                        Summary
                      </h3>
                      {section.summary.map((paragraph) => (
                        <p class="case-body">{paragraph}</p>
                      ))}
                    </div>
                    <aside class="case-meta" aria-label={`${section.title} details`}>
                      {section.role && (
                        <div class="case-meta-item">
                          <span class="case-meta-label">Role</span>
                          <p class="case-meta-value">{section.role}</p>
                        </div>
                      )}
                      {section.timeline && (
                        <div class="case-meta-item">
                          <span class="case-meta-label">Timeline</span>
                          <p class="case-meta-value">{section.timeline}</p>
                        </div>
                      )}
                    </aside>
                  </div>

                  {section.blocks.length > 0 && (
                    <div class="case-part-blocks prose case-prose">
                      {section.blocks.map((block) => (
                        <div class="case-part-block">
                          {block.heading && <h3>{block.heading}</h3>}
                          {block.paragraphs.map((paragraph) => (
                            <p>{paragraph}</p>
                          ))}
                        </div>
                      ))}
                    </div>
                  )}
                </div>
              </section>
            ))
          ) : (
            <>
              <div class="case-marquee" aria-hidden="true">
                <div class="case-marquee-track">
                  {
                    [0, 1].map(() => (
                      <div class="case-marquee-group">
                        {Array.from({ length: marqueeRepeats }).map(() => (
                          <span class="case-marquee-item">
                            <span>{d.title}</span>
                            <span class="case-marquee-sep" />
                          </span>
                        ))}
                      </div>
                    ))
                  }
                </div>
              </div>

              {
                (d.roleSummary || d.team) && (
                  <section class="case-role-block shell-case">
                    <div class="case-role-main">
                      {d.roleSummary && (
                        <>
                          <h2 class="case-section-title">My Role</h2>
                          <p class="case-body">{d.roleSummary}</p>
                        </>
                      )}
                    </div>
                    <aside class="case-meta">
                      {d.role && (
                        <div class="case-meta-item">
                          <span class="case-meta-label">Role</span>
                          <p class="case-meta-value">{d.role}</p>
                        </div>
                      )}
                      {d.market && (
                        <div class="case-meta-item">
                          <span class="case-meta-label">Product / Market</span>
                          <p class="case-meta-value">{d.market}</p>
                        </div>
                      )}
                      {period && (
                        <div class="case-meta-item">
                          <span class="case-meta-label">Year</span>
                          <p class="case-meta-value">{period}</p>
                        </div>
                      )}
                      {d.team && (
                        <div class="case-meta-item">
                          <span class="case-meta-label">Team</span>
                          <p class="case-meta-value">{d.team}</p>
                        </div>
                      )}
                      {d.tags.length > 0 && (
                        <div class="case-meta-item">
                          <span class="case-meta-label">Focus</span>
                          <p class="case-meta-value">{d.tags.join(' · ')}</p>
                        </div>
                      )}
                    </aside>
                  </section>
                )
              }

              <section class="case-process shell-case" aria-labelledby={`process-${project.id}`}>
                <h2 class="case-section-display" id={`process-${project.id}`}>
                  Process
                </h2>
                <div class="case-process-grid">
                  {
                    d.cover && (
                      <figure class="case-process-media">
                        <img src={withBase(d.cover)} alt="" loading="eager" />
                      </figure>
                    )
                  }
                  <div class="case-process-copy prose case-prose">
                    <Content />
                  </div>
                </div>
              </section>

              {
                d.impact.length > 0 && (
                  <section class="case-impact shell-case" aria-labelledby={`impact-${project.id}`}>
                    <h2 class="case-section-display" id={`impact-${project.id}`}>
                      Impact
                    </h2>
                    <ul class="case-impact-grid">
                      {d.impact.map((item) => (
                        <li class="case-impact-item">
                          <p class="case-impact-metric">{item.metric}</p>
                          <p class="case-impact-desc">{item.description}</p>
                        </li>
                      ))}
                    </ul>
                  </section>
                )
              }
            </>
          )
        }

        {
          (prevProject || nextProject) && (
            <nav class="case-pager shell-case" aria-label="Adjacent case studies">
              {prevProject ? (
                <a class="case-pager-prev" href={withBase(`projects/${prevProject.id}/`)}>
                  ← Previous: {prevProject.data.title}
                </a>
              ) : (
                <span class="case-pager-prev" />
              )}
              {nextProject ? (
                <a class="case-pager-next" href={withBase(`projects/${nextProject.id}/`)}>
                  Next: {nextProject.data.title} →
                </a>
              ) : (
                <span class="case-pager-next" />
              )}
            </nav>
          )
        }
      </article>
    </main>

    <footer class="case-footer" id="contact">
      <div class="case-footer-inner">
        <div class="case-footer-brand-row">
          <p class="case-footer-name">{site.name}</p>
          {
            linkedIn && (
              <a
                class="case-linkedin case-linkedin--footer"
                href={linkedIn.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="LinkedIn"
              >
                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                  <path
                    fill="currentColor"
                    d="M6.94 8.5H4.1V19h2.84V8.5ZM5.52 7.2a1.65 1.65 0 1 0 0-3.3 1.65 1.65 0 0 0 0 3.3ZM19.9 19h-2.84v-5.4c0-1.29-.02-2.95-1.8-2.95-1.8 0-2.08 1.4-2.08 2.86V19H10.3V8.5h2.73v1.43h.04c.38-.72 1.3-1.48 2.68-1.48 2.87 0 3.4 1.89 3.4 4.34V19Z"
                  />
                </svg>
              </a>
            )
          }
        </div>
        <div class="case-footer-meta">
          <div>
            <p class="case-footer-label">Location</p>
            <p class="case-footer-value">{site.footer.location}</p>
          </div>
          <div>
            <p class="case-footer-label">Contact</p>
            <a class="case-footer-value" href={`mailto:${site.footer.email}`}>
              {site.footer.email}
            </a>
          </div>
        </div>
      </div>
    </footer>
  </div>

  <script>
    function getPreferredTheme() {
      const stored = localStorage.getItem('theme');
      if (stored === 'light' || stored === 'dark') return stored;
      return 'dark';
    }

    function applyTheme(theme) {
      document.documentElement.setAttribute('data-theme', theme);
      document.documentElement.style.colorScheme = theme;
      const meta = document.querySelector('meta[name="theme-color"]');
      if (meta) meta.setAttribute('content', theme === 'dark' ? '#0d0d0d' : '#f3efe8');
    }

    const toggle = document.getElementById('theme-toggle');
    applyTheme(getPreferredTheme());

    toggle?.addEventListener('click', () => {
      const next =
        document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
      localStorage.setItem('theme', next);
      applyTheme(next);
    });

    const marqueeSeeds = new WeakMap();
    let marqueeResizeTimer = 0;

    function fillCaseMarquees() {
      document.querySelectorAll('.case-marquee').forEach((root) => {
        const track = root.querySelector('.case-marquee-track');
        const first = track?.querySelector('.case-marquee-group');
        if (!(track instanceof HTMLElement) || !(first instanceof HTMLElement)) return;

        if (!marqueeSeeds.has(root)) {
          marqueeSeeds.set(root, first.innerHTML);
        }
        const seed = marqueeSeeds.get(root);
        if (!seed) return;

        const targetWidth = Math.max(root.clientWidth, 1);
        track.style.animation = 'none';
        first.innerHTML = seed;

        let guard = 0;
        while (first.scrollWidth < targetWidth && guard < 80) {
          first.insertAdjacentHTML('beforeend', seed);
          guard += 1;
        }
        // Keep a little extra so the visible window never empties mid-cycle.
        if (first.scrollWidth < targetWidth * 1.25) {
          first.insertAdjacentHTML('beforeend', seed);
        }

        track.replaceChildren(first, first.cloneNode(true));
        void track.offsetWidth;
        track.style.removeProperty('animation');
      });
    }

    async function initCaseMarquees() {
      try {
        if (document.fonts?.ready) await document.fonts.ready;
      } catch {
        /* ignore */
      }
      fillCaseMarquees();
    }

    initCaseMarquees();
    window.addEventListener('resize', () => {
      window.clearTimeout(marqueeResizeTimer);
      marqueeResizeTimer = window.setTimeout(fillCaseMarquees, 100);
    });
  </script>
</BaseLayout>
