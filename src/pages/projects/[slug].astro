---
import CaseStudy from '../../components/CaseStudy.astro';
import { getPublishedProjectsOrThrow } from '../../lib/workProjects';
import '../../styles/global.css';

export async function getStaticPaths() {
  // Throws if Helpling (or any required case study) was dropped by draft/schema.
  const projects = await getPublishedProjectsOrThrow('en');

  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project, projects },
  }));
}

const { project, projects } = Astro.props;
---

<CaseStudy project={project} projects={projects} locale="en" />
