---
/**
 * Editorial deep-dive chapters for multi-part case studies (e.g. Resolution Center).
 * Layout variants create visual rhythm — not a repeating card template.
 */
import { withBase } from '../lib/paths';
import { t, type Locale } from '../lib/i18n';

interface Perspective {
  title: string;
  body: string;
}
interface Insight {
  number?: string;
  title: string;
  body: string;
}
interface Principle {
  title: string;
  body: string;
}
interface Tradeoff {
  need: string;
  constraint: string;
  response: string;
}
interface StoryFigure {
  src: string;
  alt: string;
  caption?: string;
  tone?: 'process' | 'default' | 'visual' | 'bare';
  size?: 'sm' | 'md' | 'lg' | 'full';
}
interface Solution {
  title: string;
  body?: string;
  placeholder?: string;
  figure?: StoryFigure;
}
interface Collaborator {
  role: string;
  contribution: string;
}
interface Metric {
  value: string;
  label: string;
  verified?: boolean;
  note?: string;
}
interface Chapter {
  id: string;
  title: string;
  layout:
    | 'hero'
    | 'overview'
    | 'challenge'
    | 'system'
    | 'mapping'
    | 'insights'
    | 'strategy'
    | 'design'
    | 'constraints'
    | 'solution'
    | 'collaboration'
    | 'impact'
    | 'reflection'
    | 'cta';
  tagline?: string;
  impactLine?: string;
  lead?: string;
  paragraphs?: string[];
  bullets?: string[];
  pullQuote?: string;
  placeholders?: string[];
  figures?: StoryFigure[];
  perspectives?: Perspective[];
  insights?: Insight[];
  principles?: Principle[];
  constraints?: string[];
  tradeoffs?: Tradeoff[];
  solutions?: Solution[];
  collaborators?: Collaborator[];
  metrics?: Metric[];
  before?: string[];
  after?: string[];
  roleLine?: string;
  responsibilities?: string;
  challengeLabel?: string;
  challengeIntro?: string;
  contextLabel?: string;
  roleLabel?: string;
  contactHref?: string;
  contactLabel?: string;
  contactInline?: boolean;
  contactSuffix?: string;
}

interface Props {
  chapters: Chapter[];
  locale?: Locale;
}

const { chapters, locale = 'en' } = Astro.props;
const cs = t(locale).caseStudy;

function figureClasses(fig: StoryFigure, extra = '') {
  const tone = fig.tone ?? 'process';
  const size = fig.size ?? 'md';
  return ['rc-figure', `rc-figure--${tone}`, `rc-figure--${size}`, extra].filter(Boolean).join(' ');
}
---

<div class="rc-story">
  {
    chapters.map((ch) => (
      <section class={`rc-chapter rc-chapter--${ch.layout}`} id={ch.id} aria-labelledby={`${ch.id}-title`}>
        {ch.layout === 'hero' && (
          <div class="rc-hero shell-case">
            <p class="rc-kicker">{cs.kicker}</p>
            <h3 class="rc-hero-title" id={`${ch.id}-title`}>
              {ch.title}
            </h3>
            {ch.tagline && <p class="rc-hero-tagline">{ch.tagline}</p>}
            {ch.impactLine && <p class="rc-hero-impact">{ch.impactLine}</p>}
            {(ch.figures?.length ?? 0) > 0 ? (
              <div class:list={['rc-figure-stack', { 'rc-figure-gallery': (ch.figures?.length ?? 0) > 1 }]}>
                {ch.figures?.map((fig) => (
                  <figure class={figureClasses(fig, 'rc-figure--hero')}>
                    <div class="rc-figure-frame">
                      <img src={withBase(fig.src)} alt={fig.alt} loading="lazy" decoding="async" />
                    </div>
                    {fig.caption && <figcaption class="rc-figure-caption">{fig.caption}</figcaption>}
                  </figure>
                ))}
              </div>
            ) : (
              ch.placeholders?.map((ph) => (
                <figure class="rc-placeholder rc-placeholder--hero" role="img" aria-label={ph}>
                  <span class="rc-placeholder-label">{ph}</span>
                </figure>
              ))
            )}
          </div>
        )}

        {ch.layout === 'overview' && (
          <div class="rc-overview shell-case">
            <header class="rc-chapter-head">
              <h3 class="rc-chapter-title" id={`${ch.id}-title`}>
                {ch.title}
              </h3>
            </header>
            <div class:list={['rc-overview-grid', { 'rc-overview-grid--no-role': !(ch.roleLine || ch.responsibilities) }]}>
              <div class="rc-overview-col">
                <h4 class="rc-subhead">{ch.contextLabel ?? cs.context}</h4>
                {ch.paragraphs?.map((p) => (
                  <p class="rc-body">{p}</p>
                ))}
              </div>
              <div class="rc-overview-col">
                <h4 class="rc-subhead">{ch.challengeLabel ?? cs.challenge}</h4>
                {ch.lead && <p class="rc-body">{ch.lead}</p>}
                {ch.challengeIntro && (
                  <p class="rc-body rc-body--tight">{ch.challengeIntro}</p>
                )}
                {(ch.bullets?.length ?? 0) > 0 && (
                  <ul class="rc-list">
                    {ch.bullets?.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                )}
              </div>
              {(ch.roleLine || ch.responsibilities) && (
                <div class="rc-overview-col rc-overview-col--role">
                  <h4 class="rc-subhead">{ch.roleLabel ?? cs.myRole}</h4>
                  {ch.roleLine && <p class="rc-body">{ch.roleLine}</p>}
                  {ch.responsibilities && (
                    <p class="rc-responsibilities">{ch.responsibilities}</p>
                  )}
                </div>
              )}
            </div>
          </div>
        )}

        {ch.layout === 'challenge' && (
          <div class="rc-challenge shell-case">
            <header class="rc-chapter-head">
              <h3 class="rc-chapter-title" id={`${ch.id}-title`}>
                {ch.title}
              </h3>
            </header>
            {ch.lead && <p class="rc-lead">{ch.lead}</p>}
            <div class="rc-prose-stack">
              {ch.paragraphs?.map((p) => (
                <p class="rc-body">{p}</p>
              ))}
            </div>
            <div class="rc-perspectives">
              {ch.perspectives?.map((p) => (
                <article class="rc-perspective">
                  <h4 class="rc-perspective-title">{p.title}</h4>
                  <p class="rc-body">{p.body}</p>
                </article>
              ))}
            </div>
            {ch.pullQuote && <blockquote class="rc-pull">{ch.pullQuote}</blockquote>}
            {(ch.figures?.length ?? 0) > 0 ? (
              <div class:list={['rc-figure-stack', { 'rc-figure-gallery': (ch.figures?.length ?? 0) > 1 }]}>
                {ch.figures?.map((fig) => (
                  <figure class={figureClasses(fig)}>
                    <div class="rc-figure-frame">
                      <img src={withBase(fig.src)} alt={fig.alt} loading="lazy" decoding="async" />
                    </div>
                    {fig.caption && <figcaption class="rc-figure-caption">{fig.caption}</figcaption>}
                  </figure>
                ))}
              </div>
            ) : (
              ch.placeholders?.map((ph) => (
                <figure class="rc-placeholder rc-placeholder--wide" role="img" aria-label={ph}>
                  <span class="rc-placeholder-label">{ph}</span>
                </figure>
              ))
            )}
          </div>
        )}

        {ch.layout === 'system' && (
          <div class="rc-system shell-case">
            <header class="rc-chapter-head">
              <h3 class="rc-chapter-title" id={`${ch.id}-title`}>
                {ch.title}
              </h3>
            </header>
            <div class="rc-split">
              <div class="rc-split-main">
                {ch.lead && <p class="rc-lead">{ch.lead}</p>}
                {ch.paragraphs?.map((p) => (
                  <p class="rc-body">{p}</p>
                ))}
              </div>
              <ul class="rc-list rc-list--dense">
                {ch.bullets?.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          </div>
        )}

        {ch.layout === 'mapping' && (
          <div class="rc-mapping">
            <div class="shell-case">
              <header class="rc-chapter-head">
                <h3 class="rc-chapter-title" id={`${ch.id}-title`}>
                  {ch.title}
                </h3>
              </header>
              {ch.lead && <p class="rc-lead">{ch.lead}</p>}
              <div class="rc-prose-stack">
                {ch.paragraphs?.map((p) => (
                  <p class="rc-body">{p}</p>
                ))}
              </div>
            </div>
            <div class="rc-mapping-visuals shell-case">
              {(ch.figures?.length ?? 0) > 0 ? (
                <div class:list={['rc-figure-stack', { 'rc-figure-gallery': (ch.figures?.length ?? 0) > 1 }]}>
                  {ch.figures?.map((fig) => (
                    <figure class={figureClasses(fig)}>
                      <div class="rc-figure-frame">
                        <img src={withBase(fig.src)} alt={fig.alt} loading="lazy" decoding="async" />
                      </div>
                      {fig.caption && <figcaption class="rc-figure-caption">{fig.caption}</figcaption>}
                    </figure>
                  ))}
                </div>
              ) : (
                ch.placeholders?.map((ph) => (
                  <figure class="rc-placeholder rc-placeholder--map" role="img" aria-label={ph}>
                    <span class="rc-placeholder-label">{ph}</span>
                  </figure>
                ))
              )}
            </div>
          </div>
        )}

        {ch.layout === 'insights' && (
          <div class="rc-insights shell-case">
            <header class="rc-chapter-head">
              <h3 class="rc-chapter-title" id={`${ch.id}-title`}>
                {ch.title}
              </h3>
            </header>
            {ch.lead && <p class="rc-lead">{ch.lead}</p>}
            {ch.pullQuote && <blockquote class="rc-pull">{ch.pullQuote}</blockquote>}
            <div class="rc-prose-stack">
              {ch.paragraphs?.map((p) => (
                <p class="rc-body">{p}</p>
              ))}
            </div>
            {(ch.bullets?.length ?? 0) > 0 && (
              <ul class="rc-list rc-list--dense">
                {ch.bullets?.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            )}
            {(ch.insights?.length ?? 0) > 0 && (
              <ul class="rc-insight-list">
                {ch.insights?.map((insight) => (
                  <li class="rc-insight">
                    <h4 class="rc-insight-title">{insight.title}</h4>
                    <p class="rc-body">{insight.body}</p>
                  </li>
                ))}
              </ul>
            )}
            {(ch.figures?.length ?? 0) > 0 && (
              <div class:list={['rc-figure-stack', { 'rc-figure-gallery': (ch.figures?.length ?? 0) > 1 }]}>
                {ch.figures?.map((fig) => (
                  <figure class={figureClasses(fig)}>
                    <div class="rc-figure-frame">
                      <img src={withBase(fig.src)} alt={fig.alt} loading="lazy" decoding="async" />
                    </div>
                    {fig.caption && <figcaption class="rc-figure-caption">{fig.caption}</figcaption>}
                  </figure>
                ))}
              </div>
            )}
          </div>
        )}

        {ch.layout === 'strategy' && (
          <div class="rc-strategy shell-case">
            <header class="rc-chapter-head">
              <h3 class="rc-chapter-title" id={`${ch.id}-title`}>
                {ch.title}
              </h3>
            </header>
            {ch.lead && <p class="rc-lead">{ch.lead}</p>}
            <div class="rc-principles">
              {ch.principles?.map((pr) => (
                <article class="rc-principle">
                  <h4 class="rc-principle-title">{pr.title}</h4>
                  <p class="rc-body">{pr.body}</p>
                </article>
              ))}
            </div>
            {(ch.figures?.length ?? 0) > 0 ? (
              <div class:list={['rc-figure-stack', { 'rc-figure-gallery': (ch.figures?.length ?? 0) > 1 }]}>
                {ch.figures?.map((fig) => (
                  <figure class={figureClasses(fig)}>
                    <div class="rc-figure-frame">
                      <img src={withBase(fig.src)} alt={fig.alt} loading="lazy" decoding="async" />
                    </div>
                    {fig.caption && <figcaption class="rc-figure-caption">{fig.caption}</figcaption>}
                  </figure>
                ))}
              </div>
            ) : (
              ch.placeholders?.map((ph) => (
                <figure class="rc-placeholder rc-placeholder--wide" role="img" aria-label={ph}>
                  <span class="rc-placeholder-label">{ph}</span>
                </figure>
              ))
            )}
          </div>
        )}

        {ch.layout === 'design' && (
          <div class="rc-design">
            <div class="shell-case">
              <header class="rc-chapter-head">
                <h3 class="rc-chapter-title" id={`${ch.id}-title`}>
                  {ch.title}
                </h3>
              </header>
              {ch.lead && <p class="rc-lead">{ch.lead}</p>}
              {ch.paragraphs?.map((p) => (
                <p class="rc-body">{p}</p>
              ))}
              <p class="rc-body rc-body--tight">{cs.communicate}</p>
              <ul class="rc-list">
                {ch.bullets?.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
              {ch.pullQuote && <blockquote class="rc-pull">{ch.pullQuote}</blockquote>}
            </div>
            {(ch.figures?.length ?? 0) > 0 ? (
              <div class="shell-case">
                <div class:list={['rc-figure-stack', { 'rc-figure-gallery': (ch.figures?.length ?? 0) > 1 }]}>
                  {ch.figures?.map((fig) => (
                    <figure class={figureClasses(fig)}>
                      <div class="rc-figure-frame">
                        <img src={withBase(fig.src)} alt={fig.alt} loading="lazy" decoding="async" />
                      </div>
                      {fig.caption && <figcaption class="rc-figure-caption">{fig.caption}</figcaption>}
                    </figure>
                  ))}
                </div>
              </div>
            ) : (
              <>
                <div class="rc-design-visuals shell-case">
                  {(ch.placeholders ?? []).slice(0, 2).map((ph) => (
                    <figure class="rc-placeholder rc-placeholder--ui" role="img" aria-label={ph}>
                      <span class="rc-placeholder-label">{ph}</span>
                    </figure>
                  ))}
                </div>
                {(ch.placeholders?.length ?? 0) > 2 && (
                  <div class="rc-design-compare shell-case">
                    <p class="rc-compare-label">{cs.customerProvider}</p>
                    <div class="rc-compare-grid">
                      {(ch.placeholders ?? []).slice(2).map((ph) => (
                        <figure class="rc-placeholder rc-placeholder--side" role="img" aria-label={ph}>
                          <span class="rc-placeholder-label">{ph}</span>
                        </figure>
                      ))}
                    </div>
                  </div>
                )}
              </>
            )}
          </div>
        )}

        {ch.layout === 'constraints' && (
          <div class="rc-constraints shell-case">
            <header class="rc-chapter-head">
              <h3 class="rc-chapter-title" id={`${ch.id}-title`}>
                {ch.title}
              </h3>
            </header>
            {ch.lead && <p class="rc-lead">{ch.lead}</p>}
            <ul class="rc-list rc-list--constraints">
              {ch.constraints?.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
            {(ch.tradeoffs?.length ?? 0) > 0 && (
              <div class="rc-tradeoffs" aria-label={cs.tradeoffsLabel}>
                <div class="rc-tradeoff-head" aria-hidden="true">
                  <span>{cs.userNeed}</span>
                  <span>{cs.constraint}</span>
                  <span>{cs.designResponse}</span>
                </div>
                {ch.tradeoffs?.map((tradeoff) => (
                  <div class="rc-tradeoff">
                    <p>
                      <span class="rc-tradeoff-mobile-label">{cs.userNeed}</span>
                      {tradeoff.need}
                    </p>
                    <p>
                      <span class="rc-tradeoff-mobile-label">{cs.constraint}</span>
                      {tradeoff.constraint}
                    </p>
                    <p>
                      <span class="rc-tradeoff-mobile-label">{cs.designResponse}</span>
                      {tradeoff.response}
                    </p>
                  </div>
                ))}
              </div>
            )}
          </div>
        )}

        {ch.layout === 'solution' && (
          <div class="rc-solution shell-case">
            <header class="rc-chapter-head">
              <h3 class="rc-chapter-title" id={`${ch.id}-title`}>
                {ch.title}
              </h3>
            </header>
            {ch.lead && <p class="rc-lead">{ch.lead}</p>}
            {(ch.figures?.length ?? 0) > 0 && (
              <div class:list={['rc-figure-stack', { 'rc-figure-gallery': (ch.figures?.length ?? 0) > 1 }]}>
                {ch.figures?.map((fig) => (
                  <figure class={figureClasses(fig)}>
                    <div class="rc-figure-frame">
                      <img src={withBase(fig.src)} alt={fig.alt} loading="lazy" decoding="async" />
                    </div>
                    {fig.caption && <figcaption class="rc-figure-caption">{fig.caption}</figcaption>}
                  </figure>
                ))}
              </div>
            )}
            <div class="rc-solution-grid">
              {ch.solutions?.map((sol) => (
                <article class="rc-solution-item">
                  <h4 class="rc-solution-title">{sol.title}</h4>
                  {sol.body && <p class="rc-body">{sol.body}</p>}
                  {sol.figure && (
                    <figure class={figureClasses(sol.figure, 'rc-figure--solution')}>
                      <div class="rc-figure-frame">
                        <img
                          src={withBase(sol.figure.src)}
                          alt={sol.figure.alt}
                          loading="lazy"
                          decoding="async"
                        />
                      </div>
                      {sol.figure.caption && (
                        <figcaption class="rc-figure-caption">{sol.figure.caption}</figcaption>
                      )}
                    </figure>
                  )}
                </article>
              ))}
            </div>
          </div>
        )}

        {ch.layout === 'collaboration' && (
          <div class="rc-collab shell-case">
            <header class="rc-chapter-head">
              <h3 class="rc-chapter-title" id={`${ch.id}-title`}>
                {ch.title}
              </h3>
            </header>
            {ch.lead && <p class="rc-lead">{ch.lead}</p>}
            <ul class="rc-collab-list">
              {ch.collaborators?.map((c) => (
                <li class="rc-collab-item">
                  <strong class="rc-collab-role">{c.role}</strong>
                  <span class="rc-collab-contrib">{c.contribution}</span>
                </li>
              ))}
            </ul>
            {(ch.figures?.length ?? 0) > 0 ? (
              <div class:list={['rc-figure-stack', { 'rc-figure-gallery': (ch.figures?.length ?? 0) > 1 }]}>
                {ch.figures?.map((fig) => (
                  <figure class={figureClasses(fig)}>
                    <div class="rc-figure-frame">
                      <img src={withBase(fig.src)} alt={fig.alt} loading="lazy" decoding="async" />
                    </div>
                    {fig.caption && <figcaption class="rc-figure-caption">{fig.caption}</figcaption>}
                  </figure>
                ))}
              </div>
            ) : (
              ch.placeholders?.map((ph) => (
                <figure class="rc-placeholder rc-placeholder--wide" role="img" aria-label={ph}>
                  <span class="rc-placeholder-label">{ph}</span>
                </figure>
              ))
            )}
          </div>
        )}

        {ch.layout === 'impact' && (
          <div class="rc-impact shell-case">
            <header class="rc-chapter-head">
              <h3 class="rc-chapter-title" id={`${ch.id}-title`}>
                {ch.title}
              </h3>
            </header>
            {ch.metrics?.[0] && (
              <p class="rc-impact-hero">
                <span class="rc-impact-hero-value">{ch.metrics[0].value}</span>
                <span class="rc-impact-hero-label">{ch.metrics[0].label}</span>
              </p>
            )}
            {ch.lead && <p class="rc-body">{ch.lead}</p>}
            {ch.pullQuote && <blockquote class="rc-pull">{ch.pullQuote}</blockquote>}
            {(ch.metrics?.length ?? 0) > 1 && (
              <ul class="rc-metric-secondary">
                {ch.metrics?.slice(1).map((m) => (
                  <li class:list={['rc-metric-item', { 'rc-metric-item--placeholder': !m.verified }]}>
                    <p class="rc-metric-value">{m.value}</p>
                    <p class="rc-metric-label">{m.label}</p>
                    {m.note && <p class="rc-metric-note">{m.note}</p>}
                  </li>
                ))}
              </ul>
            )}
            {((ch.before?.length ?? 0) > 0 || (ch.after?.length ?? 0) > 0) && (
              <div class="rc-before-after">
                {(ch.before?.length ?? 0) > 0 && (
                  <div class="rc-ba-col">
                    <h4 class="rc-ba-label">{cs.before}</h4>
                    <ul class="rc-ba-list">
                      {ch.before?.map((item) => (
                        <li>{item}</li>
                      ))}
                    </ul>
                  </div>
                )}
                {(ch.after?.length ?? 0) > 0 && (
                  <div class="rc-ba-col">
                    <h4 class="rc-ba-label">{cs.after}</h4>
                    <ul class="rc-ba-list">
                      {ch.after?.map((item) => (
                        <li>{item}</li>
                      ))}
                    </ul>
                  </div>
                )}
              </div>
            )}
            {(ch.figures?.length ?? 0) > 0 && (
              <div class:list={['rc-figure-stack', { 'rc-figure-gallery': (ch.figures?.length ?? 0) > 1 }]}>
                {ch.figures?.map((fig) => (
                  <figure class={figureClasses(fig)}>
                    <div class="rc-figure-frame">
                      <img src={withBase(fig.src)} alt={fig.alt} loading="lazy" decoding="async" />
                    </div>
                    {fig.caption && <figcaption class="rc-figure-caption">{fig.caption}</figcaption>}
                  </figure>
                ))}
              </div>
            )}
          </div>
        )}

        {ch.layout === 'reflection' && (
          <div class="rc-reflection shell-case">
            <header class="rc-chapter-head">
              <h3 class="rc-chapter-title" id={`${ch.id}-title`}>
                {ch.title}
              </h3>
            </header>
            {ch.pullQuote && <blockquote class="rc-pull rc-pull--reflection">{ch.pullQuote}</blockquote>}
            {ch.paragraphs?.map((p) => (
              <p class="rc-body">{p}</p>
            ))}
          </div>
        )}

        {ch.layout === 'cta' && (
          <div class="rc-cta shell-case">
            <p class="rc-cta-lead" id={`${ch.id}-title`}>
              {cs.ctaLead}{' '}
              <a class="rc-cta-link rc-cta-link--inline" href="mailto:lucianareyes@gmail.com">
                {cs.ctaLink}
              </a>
            </p>
          </div>
        )}
      </section>
    ))
  }
</div>
