---
import { getSite } from '../lib/site';
import { withBase } from '../lib/paths';

const site = getSite();
const home = withBase('/');
const nav = site.nav ?? [
  { label: 'Work', href: '#work' },
  { label: 'About', href: '#about' },
  { label: 'Contact', href: '#contact' },
];
---

<header class="shell topbar">
  <a class="brand" href={home}>{site.name.toUpperCase()}</a>
  <nav class="site-nav" aria-label="Primary">
    <ul class="site-nav-list">
      {
        nav.map((item) => {
          const hash = item.href.startsWith('#') ? item.href : `#${item.href}`;
          return (
            <li>
              <a href={`${home}${hash}`}>{item.label}</a>
            </li>
          );
        })
      }
    </ul>
  </nav>
  <button
    type="button"
    class="theme-toggle"
    id="theme-toggle"
    aria-label="Switch to light mode"
  >
    <!-- Show the destination theme: sun in dark (→ light), moon in light (→ dark) -->
    <span class="material-symbols-outlined icon-sun" aria-hidden="true">light_mode</span>
    <span class="material-symbols-outlined icon-moon" aria-hidden="true">dark_mode</span>
  </button>
</header>
