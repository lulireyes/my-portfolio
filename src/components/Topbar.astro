---
import { getSite } from '../lib/site';
import { localeHome, type Locale } from '../lib/i18n';
import LangSwitch from './LangSwitch.astro';

interface Props {
  locale?: Locale;
  langHrefs?: Partial<Record<Locale, string>>;
}

const { locale = 'en', langHrefs } = Astro.props;
const site = getSite(locale);
const home = localeHome(locale);
const nav = site.nav ?? [
  { label: 'Work', href: '#work' },
  { label: 'About', href: '#about' },
  { label: 'Contact', href: '#contact' },
];
const linkedIn = site.links?.find((l) => /linkedin/i.test(l.label) || /linkedin/i.test(l.href));
const gitHub = site.links?.find((l) => /github/i.test(l.label) || /github\.com/i.test(l.href));
---

<header class="shell topbar">
  <a class="brand" href={home}>{site.name.toUpperCase()}</a>
  <nav class="site-nav" id="site-nav" aria-label="Primary">
    <ul class="site-nav-list">
      {
        nav.map((item) => {
          const hash = item.href.startsWith('#') ? item.href : `#${item.href}`;
          const isContact = hash.toLowerCase() === '#contact';
          const href = isContact ? `mailto:${site.email}` : `${home}${hash}`;
          return (
            <li>
              <a href={href}>{item.label}</a>
            </li>
          );
        })
      }
    </ul>
    <div class="site-nav-tools">
      <div class="topbar-lang">
        <LangSwitch locale={locale} hrefs={langHrefs} />
      </div>
      <button
        type="button"
        class="theme-toggle"
        id="theme-toggle"
        aria-label="Switch to light mode"
      >
        <svg class="theme-icon icon-sun" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <circle cx="12" cy="12" r="3.75"></circle>
          <path
            d="M12 2.5v2.25M12 19.25V21.5M2.5 12h2.25M19.25 12H21.5M5.05 5.05l1.6 1.6M17.35 17.35l1.6 1.6M5.05 18.95l1.6-1.6M17.35 6.65l1.6-1.6"
          ></path>
        </svg>
        <svg class="theme-icon icon-moon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M20.5 14.25A8.25 8.25 0 1 1 9.75 3.5 6.75 6.75 0 0 0 20.5 14.25z"></path>
        </svg>
      </button>
    </div>
    {
      (linkedIn || gitHub) && (
        <div class="site-nav-social" aria-label="Social">
          {
            linkedIn && (
              <a
                class="site-nav-social-link"
                href={linkedIn.href}
                target="_blank"
                rel="noopener noreferrer"
              >
                <span class="visually-hidden">LinkedIn</span>
                <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
                  <path
                    fill="currentColor"
                    d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"
                  />
                </svg>
              </a>
            )
          }
          {
            gitHub && (
              <a
                class="site-nav-social-link"
                href={gitHub.href}
                target="_blank"
                rel="noopener noreferrer"
              >
                <span class="visually-hidden">GitHub</span>
                <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
                  <path
                    fill="currentColor"
                    d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.385-1.335-1.79-1.335-1.79-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
                  />
                </svg>
              </a>
            )
          }
        </div>
      )
    }
  </nav>
  <button
    type="button"
    class="menu-toggle"
    id="menu-toggle"
    aria-label="Open menu"
    aria-expanded="false"
    aria-controls="site-nav"
  >
    <svg class="menu-icon icon-menu" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <line x1="5" y1="8" x2="19" y2="8"></line>
      <line x1="5" y1="16" x2="19" y2="16"></line>
    </svg>
    <svg class="menu-icon icon-close" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <line x1="7" y1="7" x2="17" y2="17"></line>
      <line x1="17" y1="7" x2="7" y2="17"></line>
    </svg>
  </button>
</header>

<script>
  const menuToggle = document.getElementById('menu-toggle');
  const siteNav = document.getElementById('site-nav');

  function setMenuOpen(open: boolean) {
    document.documentElement.classList.toggle('nav-open', open);
    menuToggle?.setAttribute('aria-expanded', open ? 'true' : 'false');
    menuToggle?.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  }

  function isMenuOpen() {
    return document.documentElement.classList.contains('nav-open');
  }

  menuToggle?.addEventListener('click', () => {
    setMenuOpen(!isMenuOpen());
  });

  siteNav?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setMenuOpen(false));
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && isMenuOpen()) {
      setMenuOpen(false);
      menuToggle?.focus();
    }
  });

  const mq = window.matchMedia('(min-width: 641px)');
  const syncDesktop = () => {
    if (mq.matches) setMenuOpen(false);
  };
  mq.addEventListener('change', syncDesktop);
</script>
