---
import { getSite } from '../lib/site';
import { withBase } from '../lib/paths';

const site = getSite();
const home = withBase('/');
const nav = site.nav ?? [
  { label: 'Work', href: '#work' },
  { label: 'About', href: '#about' },
  { label: 'Contact', href: '#contact' },
];
---

<header class="shell topbar">
  <a class="brand" href={home}>{site.name.toUpperCase()}</a>
  <nav class="site-nav" aria-label="Primary">
    <ul class="site-nav-list">
      {
        nav.map((item) => {
          const hash = item.href.startsWith('#') ? item.href : `#${item.href}`;
          return (
            <li>
              <a href={`${home}${hash}`}>{item.label}</a>
            </li>
          );
        })
      }
    </ul>
  </nav>
  <button
    type="button"
    class="theme-toggle"
    id="theme-toggle"
    aria-label="Switch to light mode"
  >
    <!-- Destination theme: sun in dark (→ light), moon in light (→ dark). Stroke-only, no fill. -->
    <svg class="theme-icon icon-sun" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <circle cx="12" cy="12" r="3.75"></circle>
      <path
        d="M12 2.5v2.25M12 19.25V21.5M2.5 12h2.25M19.25 12H21.5M5.05 5.05l1.6 1.6M17.35 17.35l1.6 1.6M5.05 18.95l1.6-1.6M17.35 6.65l1.6-1.6"
      ></path>
    </svg>
    <svg class="theme-icon icon-moon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M20.5 14.25A8.25 8.25 0 1 1 9.75 3.5 6.75 6.75 0 0 0 20.5 14.25z"></path>
    </svg>
  </button>
</header>
