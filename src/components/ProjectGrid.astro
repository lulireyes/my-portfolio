---
import { dictionary, localizedPath } from '../i18n';
import type { Locale } from '../config';
import type { ProjectRow } from './ProjectIndex.astro';

interface Props {
  locale: Locale;
  projects: ProjectRow[];
}

import './ProjectGrid.css';

const { locale, projects } = Astro.props;
const t = dictionary(locale);
---

<div class="grid">
  {
    projects.map((project) => (
      <figure class="grid__item">
        <a
          class="grid__link"
          href={localizedPath(locale, `/proyectos/${project.slug}`)}
        >
          <span class="grid__ph">{project.coverAlt}</span>
        </a>
        <figcaption>
          {project.number} — {t.index.captionPlaceholder}
        </figcaption>
      </figure>
    ))
  }
</div>
