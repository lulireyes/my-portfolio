---
import type { Locale } from '../config';
import { dictionary } from '../i18n';

interface Props {
  locale: Locale;
}

import './Services.css';

const { locale } = Astro.props;
const t = dictionary(locale);
---

<section class="services" id="servicios" aria-labelledby="serv-t">
  <h2 id="serv-t">{t.services.title}</h2>
  <div class="services__grid">
    {
      t.services.items.map((item) => (
        <div class="services__item">
          <p class="services__code">{item.code}</p>
          <h3>{item.title}</h3>
          <p class="services__body">{item.body}</p>
        </div>
      ))
    }
  </div>
</section>
