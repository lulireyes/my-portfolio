---
import type { Locale } from '../config';
import { dictionary } from '../i18n';

interface Props {
  locale: Locale;
}

import './Footer.css';

const { locale } = Astro.props;
const t = dictionary(locale);
---

<footer class="footer">
  <div class="footer__meta">
    <span>{t.footer.copy}</span>
    <span>{t.footer.line}</span>
  </div>
</footer>
