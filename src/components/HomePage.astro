---
import { getCollection } from 'astro:content';
import type { Locale } from '../config';
import { dictionary } from '../i18n';
import Contact from './Contact.astro';
import Footer from './Footer.astro';
import Process from './Process.astro';
import ProjectGrid from './ProjectGrid.astro';
import ProjectIndex from './ProjectIndex.astro';
import Services from './Services.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = dictionary(locale);
const entries = (await getCollection('proyectos')).sort((a, b) =>
  a.data.number.localeCompare(b.data.number),
);
const projects = entries.map((entry) => ({
  slug: entry.id,
  title: entry.data.title,
  number: entry.data.number,
  disciplines: [...entry.data.disciplines],
  year: entry.data.year,
  status: entry.data.status,
  cover: entry.data.cover,
  coverAlt: entry.data.coverAlt,
}));
---

<main id="content">
  <section class="hero" id="top">
    <h1>{t.hero.title}</h1>
    <p>{t.hero.aside}</p>
  </section>
  <ProjectIndex locale={locale} projects={projects} />
  <ProjectGrid locale={locale} projects={projects} />
  <Services locale={locale} />
  <Process locale={locale} />
  <Contact locale={locale} />
</main>
<Footer locale={locale} />

<style>
  .hero {
    padding: 120px 0 140px;
    display: flex;
    flex-wrap: wrap;
    gap: 32px 40px;
    align-items: flex-end;
  }

  .hero h1 {
    flex: 999 1 640px;
    margin: 0;
    font-size: clamp(40px, 5.4vw, 78px);
    line-height: 1.02;
    font-weight: 500;
    letter-spacing: -0.03em;
    font-stretch: 90%;
    font-variation-settings: 'wdth' 90;
  }

  .hero p {
    flex: 1 1 260px;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.6;
    color: var(--ink-soft);
  }

  @media (max-width: 720px) {
    .hero {
      padding: 64px 0 80px;
    }
  }
</style>
