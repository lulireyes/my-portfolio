---
import '../styles/global.css';
import '../components/Footer.css';
import { site, type Locale } from '../config';
import { dictionary } from '../i18n';
import Header from '../components/Header.astro';
import Loader from '../components/Loader.astro';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  projectCount: number;
}

const { locale, title, description, projectCount } = Astro.props;
const t = dictionary(locale);
const pageTitle = title ? `${title} — ${t.meta.title}` : t.meta.title;
const pageDescription = description ?? t.meta.description;
const canonical = new URL(Astro.url.pathname, site.domain).href;
const ogImage = new URL('/favicons/og.png', site.domain).href;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <link rel="icon" href="/favicons/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicons/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/favicons/apple-touch-icon.png" sizes="180x180" />
    <link rel="alternate" hreflang="es" href={new URL(Astro.url.pathname.replace(/^\/en/, '') || '/', site.domain).href} />
    <link rel="alternate" hreflang="en" href={new URL(Astro.url.pathname.startsWith('/en') ? Astro.url.pathname : `/en${Astro.url.pathname === '/' ? '' : Astro.url.pathname}`, site.domain).href} />
    <script is:inline>
      (function () {
        try {
          var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          var seen = false;
          try {
            seen = sessionStorage.getItem('reyes-studio-loader') === '1';
          } catch (e) {}
          if (!reduce && !seen) document.documentElement.classList.add('rs-load');
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#content">{t.skip}</a>
    <Loader />
    <div class="rs-page">
      <div class="page-shell">
        <Header
          locale={locale}
          projectCount={projectCount}
          currentPath={Astro.url.pathname}
        />
        <slot />
      </div>
      <p class="footer__mark" aria-hidden="true">Reyes<span>.</span></p>
    </div>
  </body>
</html>
